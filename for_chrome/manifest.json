{
  "manifest_version": 3,
  "name": "Komica 貼文記憶器",
  "version": "1.7.0.0",
  "description": "在支援的 Komica 網站上新增記憶、隱藏按鈕，並提供 NGID 與關鍵字過濾功能，方便您追蹤與管理討論串。",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.komica1.org/*",
    "https://*.komica.org/*",
    "https://*.komica2.net/*",
    "https://*.2cat.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.komica1.org/*/*",
        "https://*.komica.org/*/*",
        "https://*.komica2.net/*/*",
        "https://*.2cat.org/*/*",
        "https://gita.komica1.org/*/*",
        "https://gaia.komica1.org/*/*",
        "https://atri.komica1.org/*/*",
        "https://iris.komica1.org/*/*",
        "https://sora.komica1.org/*/*",
        "https://grea.komica1.org/*/*",
        "https://2cat.komica1.org/*/*",
        "https://tomo.komica1.org/*/*",
        "https://luna.komica1.org/*/*",
        "https://yuki.komica1.org/*/*"
      ],
      "js": [
        "content_script.js"
      ],
      "all_frames": true
    }
  ],
  "action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Komica 貼文記憶器",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
